# ============================================================================
# WATA MCP — пример конфигурации. Скопируйте в .env и заполните.
# .env добавлен в .gitignore и НИКОГДА не должен попадать в публичный репозиторий.
# ============================================================================

# --- Режим 1 (основной): доступ ко ВСЕМУ кабинету по сессии ---
# Логин выполняется командой `npx wata-mcp login` (email -> пароль -> код с почты).
# Сессия сохраняется в ~/.wata-mcp/session.json и живёт ~60 дней.
# Эти переменные нужны только для неинтерактивного автологина:
WATA_EMAIL=
WATA_PASSWORD=

# --- Режим 2 (фолбэк): готовая cookie-строка из DevTools ---
# Достаточно auth_cookie и XSRF-TOKEN. Используйте, если не хотите хранить пароль.
WATA_COOKIE=

# --- Режим 3 (дополнительный): публичный API эквайринга ---
# JWT выдаётся в ЛК и действует ТОЛЬКО в рамках одного терминала.
WATA_ACQ_TOKEN=

# --- Тонкая настройка ---
# Минимальная пауза между запросами к ЛК, мс (защита от DDoS-Guard).
WATA_MIN_REQUEST_INTERVAL_MS=350
# Максимум повторов при сетевых ошибках / challenge.
WATA_MAX_RETRIES=3
# Каталог для сессии и аудит-лога.
WATA_HOME=
